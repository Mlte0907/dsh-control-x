{
  "name": "dsh-control-x",
  "version": "0.3.0",
  "description": "DSH 插件：为 Agent 提供浏览器（headless CDP）与本机桌面（UIA/SendInput）的统一控制面，先观察后动作、不打扰用户。",
  "type": "module",
  "main": "./lib/index.js",
  "files": [
    "lib/",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "dsh-plugin.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "engines": {
      "dsh": ">=0.1.2-rc.1"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/core/errors.js",
    "spike:browser": "node spikes/browser-probe.mjs",
    "spike:uia": "powershell -NoProfile -ExecutionPolicy Bypass -File spikes/uia-powershell.ps1",
    "spike:koffi": "node spikes/koffi-probe.mjs",
    "verify:m1": "node scripts/m1-verify.mjs",
    "verify:m2": "node scripts/m2-verify.mjs",
    "test": "node --test tests/smoke.test.mjs tests/ui.test.mjs tests/browser-idle.test.mjs",
    "verify:m3": "node scripts/m3-verify.mjs",
    "selfcheck": "node scripts/dsh-selfcheck.mjs"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.3",
    "koffi": "^2.15.6",
    "playwright-core": "^1.59.1"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./dsh-plugin.json": "./dsh-plugin.json",
    "./package.json": "./package.json"
  }
}
